# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=False
PYTHON_VERSION=3.12.0

# 允许的主机，用英文逗号分隔
ALLOWED_HOSTS=localhost,127.0.0.1,skatespot-backend.onrender.com,skatespot-backend.koyeb.app
CSRF_TRUSTED_ORIGINS=https://skatespot-backend.onrender.com,https://skatespot-backend.koyeb.app

# 跨域来源，用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://your-frontend-domain.vercel.app

# 推荐：Supabase PostgreSQL 连接字符串（Pooler 事务模式）
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# 或使用分项配置（Supabase 示例）
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# SQLite（本地默认，无需密码）
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# MySQL 示例
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=skatespot
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
